{
	"format_version": "1.8.0",
	"animations": {
		"animation.gold_chicken.baby_transform": {
			"loop": true,
			"animation_length": 0.625,
			"bones": {
				"head": {
					"scale": 2
				},
				"geodo": {
					"position": [0, -4, 0]
				}
			}
		},
		"animation.gold_chicken.general": {
			"loop": true,
			"bones": {
				"wing0": {
					"rotation": [0, 0, "variable.wing_flap - this"]
				},
				"wing1": {
					"rotation": [0, 0, "-variable.wing_flap - this"]
				}
			}
		},
		"animation.gold_chicken.move": {
			"loop": true,
			"anim_time_update": "query.modified_distance_moved",
			"bones": {
				"leg0": {
					"rotation": ["math.cos(query.anim_time * 38.17) *  80.0", 0, 0]
				},
				"leg1": {
					"rotation": ["math.cos(query.anim_time * 38.17) * -80.0", 0, 0]
				}
			}
		}
	}
}