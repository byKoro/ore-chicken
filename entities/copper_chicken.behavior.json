{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "oc:copper_chicken",
      "runtime_identifier": "minecraft:chicken",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "oc:oxidation": {
          "type": "int",
          "range": [0, 3],
          "default": 0,
          "client_sync": true
        },
        "oc:wax": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "minecraft:copper_chicken_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["minecraft:copper_block"],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        }
      },
      "minecraft:copper_chicken_adult": {
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(1,7)",
          "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/copper_chicken.json"
        },
        "minecraft:breedable": {
          "require_tame": false,
          "breeds_with": {
            "mate_type": "oc:copper_chicken",
            "baby_type": "oc:copper_chicken",
            "breed_event": {
              "event": "minecraft:entity_born",
              "target": "baby"
            }
          },
          "breed_items": ["minecraft:copper_block"]
        },
        "minecraft:behavior.breed": {
          "priority": 3,
          "speed_multiplier": 1
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": ["zombie"],
          "seats": {
            "position": [0, 0.4, 0]
          }
        }
      },
      "oc:statue": {
        "minecraft:movement": { "value": 0 },
        "minecraft:knockback_resistance": { "value": 1 },
        "minecraft:behavior.random_stroll": {
          "priority": 0,
          "speed_multiplier": 0
        },
        "minecraft:behavior.panic": { "priority": 0, "speed_multiplier": 0 },
        "minecraft:behavior.tempt": { "priority": 0, "speed_multiplier": 0 },
        "minecraft:behavior.breed": { "priority": 0, "speed_multiplier": 0 },
        "minecraft:behavior.mount_pathing": {
          "priority": 0,
          "speed_multiplier": 0
        },
        "minecraft:behavior.follow_parent": {
          "priority": 0,
          "speed_multiplier": 0
        }
      }
    },
    "components": {
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.wax_on",
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "domain": "hand",
                    "subject": "other",
                    "test": "has_equipment",
                    "value": "honeycomb"
                  },
                  {
                    "domain": "oc:wax",
                    "test": "bool_property",
                    "value": false
                  }
                ]
              },
              "event": "oc:wax_on",
              "target": "self"
            },
            "particle_on_start": { "copper_event": "wax_on" },
            "use_item": true,
            "swing": true
          },
          {
            "interact_text": "action.interact.wax_off",
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "domain": "hand",
                    "subject": "other",
                    "test": "has_equipment_tag",
                    "value": "minecraft:is_axe"
                  },
                  {
                    "domain": "oc:wax",
                    "test": "bool_property",
                    "value": true
                  },
                  {
                    "domain": "oc:oxidation",
                    "test": "int_property",
                    "operator": ">",
                    "value": 0
                  }
                ]
              },
              "event": "oc:wax_off",
              "target": "self"
            },
            "particle_on_start": { "copper_event": "wax_off" },
            "hurt_item": 1,
            "swing": true
          },
          {
            "interact_text": "action.interact.scrape",
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "domain": "hand",
                    "subject": "other",
                    "test": "has_equipment_tag",
                    "value": "minecraft:is_axe"
                  },
                  {
                    "domain": "oc:wax",
                    "test": "bool_property",
                    "value": false
                  },
                  {
                    "domain": "oc:oxidation",
                    "test": "int_property",
                    "operator": ">",
                    "value": 0
                  }
                ]
              },
              "event": "oc:scrape",
              "target": "self"
            },
            "particle_on_start": { "copper_event": "scrape" },
            "hurt_item": 1,
            "swing": true
          }
        ]
      },
      "minecraft:type_family": {
        "family": ["chicken", "mob"]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 0.8
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 4,
        "max": 4
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": { "value": 0.2 },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "fall",
          "deals_damage": false
        }
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:balloonable": { "mass": 0.5 },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.5 },
      "minecraft:behavior.mount_pathing": {
        "priority": 2,
        "speed_multiplier": 1.5,
        "target_dist": 0,
        "track_target": true
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1,
        "items": ["minecraft:copper_block"]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": { "priority": 8 },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/copper_chicken.json"
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "weight": 95,
            "trigger": "minecraft:spawn_adult"
          },
          {
            "weight": 5,
            "add": {
              "component_groups": ["minecraft:copper_chicken_baby"]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "remove": {},
        "add": {
          "component_groups": ["minecraft:copper_chicken_baby"]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": ["minecraft:copper_chicken_baby"]
        },
        "add": {
          "component_groups": ["minecraft:copper_chicken_adult"]
        }
      },
      "minecraft:spawn_adult": {
        "add": {
          "component_groups": ["minecraft:copper_chicken_adult"]
        }
      },
      "oc:wax_on": {
        "set_property": { "oc:wax": true }
      },
      "oc:wax_off": {
        "sequence": [
          {
            "set_property": { "oc:wax": false }
          },
          {
            "first_valid": [
              {
                "filters": {
                  "domain": "oc:oxidation",
                  "test": "int_property",
                  "value": 3
                },
                "set_property": { "oc:oxidation": 2 }
              },
              {
                "filters": {
                  "domain": "oc:oxidation",
                  "test": "int_property",
                  "value": 2
                },
                "set_property": { "oc:oxidation": 1 }
              },
              {
                "filters": {
                  "domain": "oc:oxidation",
                  "test": "int_property",
                  "value": 1
                },
                "set_property": { "oc:oxidation": 0 }
              }
            ]
          }
        ]
      },
      "oc:scrape": {
        "first_valid": [
          {
            "filters": {
              "domain": "oc:oxidation",
              "test": "int_property",
              "value": 3
            },
            "set_property": { "oc:oxidation": 2 }
          },
          {
            "filters": {
              "domain": "oc:oxidation",
              "test": "int_property",
              "value": 2
            },
            "set_property": { "oc:oxidation": 1 }
          },
          {
            "filters": {
              "domain": "oc:oxidation",
              "test": "int_property",
              "value": 1
            },
            "set_property": { "oc:oxidation": 0 }
          }
        ]
      },
      "oc:become_statue": {
        "add": { "component_groups": ["oc:statue"] }
      }
    }
  }
}
